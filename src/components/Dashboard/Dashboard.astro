---
import Layout from '../../layouts/Layout.astro';

const apiBase = import.meta.env.DEV
	? import.meta.env.PUBLIC_BACKEND_URL_DEV
	: import.meta.env.PUBLIC_BACKEND_URL_PROD;
---

<Layout>
	<div class="min-h-screen px-4 pb-10 pt-4 sm:px-6 lg:px-8">

		<section class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
			<div class="rounded-[14px] border border-[rgba(15,27,43,0.08)] bg-[#f7f7f4] p-4 shadow-[0_10px_0_rgba(47,60,86,0.08)]">
				<h2 class="mb-3 text-[12px] font-bold uppercase tracking-[0.16em] text-[#2f3c56]">
					Año seleccionado / periodo
				</h2>
				<div class="flex flex-wrap items-center gap-2">
					<input
						id="monthInput"
						type="month"
						class="rounded-full border border-[#d1d3d7] bg-white px-3 py-2 text-xs font-['Space_Grotesk']"
					/>
					<button
						id="rangeMonthly"
						class="pill active rounded-full border border-[#d1d3d7] bg-white px-3 py-2 text-xs font-semibold text-[#2f3c56]"
						type="button"
					>
						Mes
					</button>
					<button
						id="rangeAnnual"
						class="pill rounded-full border border-[#d1d3d7] bg-white px-3 py-2 text-xs font-semibold text-[#2f3c56]"
						type="button"
					>
						Anual
					</button>
				</div>
			</div>

			<div class="rounded-[14px] border border-[rgba(15,27,43,0.08)] bg-[#f7f7f4] p-4 shadow-[0_10px_0_rgba(47,60,86,0.08)]">
				<h2 class="mb-3 text-[12px] font-bold uppercase tracking-[0.16em] text-[#2f3c56]">
					Periodo completo
				</h2>
				<div class="mb-2 h-4 overflow-hidden rounded-full bg-[#e1e3e6]">
					<div
						class="h-full w-0 rounded-full bg-gradient-to-r from-[#1d8f5a] to-[#18b26b] transition-[width] duration-300"
						id="periodProgress"
					></div>
				</div>
				<div class="text-sm font-bold text-[#1d8f5a]" id="periodLabel">0%</div>
			</div>

			<div class="rounded-[14px] border border-[rgba(15,27,43,0.08)] bg-[#f7f7f4] p-4 shadow-[0_10px_0_rgba(47,60,86,0.08)]">
				<h2 class="mb-3 text-[12px] font-bold uppercase tracking-[0.16em] text-[#2f3c56]">
					Tasa de ahorro del periodo
				</h2>
				<p class="text-sm font-semibold" id="savingsRate">Ahorro 0% de tus ingresos</p>
			</div>

			<div class="rounded-[14px] border border-[rgba(15,27,43,0.08)] bg-[#f7f7f4] p-4 shadow-[0_10px_0_rgba(47,60,86,0.08)]">
				<h2 class="mb-3 text-[12px] font-bold uppercase tracking-[0.16em] text-[#2f3c56]">
					Saldo restante
				</h2>
				<p class="text-sm font-semibold" id="remainingBalance">$0</p>
			</div>

			<div
				class="rounded-[14px] border border-[rgba(15,27,43,0.08)] bg-[#f7f7f4] p-4 shadow-[0_10px_0_rgba(47,60,86,0.08)] md:col-span-2 xl:col-span-2"
			>
				<h2 class="mb-3 text-[12px] font-bold uppercase tracking-[0.16em] text-[#2f3c56]">
					Registrar movimiento
				</h2>
				<div class="mb-3 grid gap-2 sm:grid-cols-2">
					<input
						id="labelInput"
						type="text"
						placeholder="Concepto"
						maxlength="60"
						class="w-full rounded-lg border border-[#d1d3d7] bg-white px-3 py-2 text-sm"
					/>
					<input
						id="amountInput"
						type="number"
						step="0.01"
						min="0"
						placeholder="Monto"
						class="w-full rounded-lg border border-[#d1d3d7] bg-white px-3 py-2 text-sm"
					/>
				</div>
				<div class="flex flex-wrap gap-2">
					<button
						class="rounded-lg bg-[#1d8f5a] px-3 py-2 text-xs font-semibold text-white"
						data-category="income"
						type="button"
					>
						Agregar ingreso
					</button>
					<button
						class="rounded-lg bg-[#cc2e8c] px-3 py-2 text-xs font-semibold text-white"
						data-category="expense"
						type="button"
					>
						Agregar gasto
					</button>
					<button
						class="rounded-lg bg-[#2a6fd2] px-3 py-2 text-xs font-semibold text-white"
						data-category="savings"
						type="button"
					>
						Agregar ahorro
					</button>
				</div>
				<div class="mt-2 min-h-[16px] text-xs text-[#2f3c56]" id="entryMessage"></div>
			</div>
		</section>

		<section class="mt-5 grid gap-5 xl:grid-cols-[minmax(0,2.2fr)_minmax(0,1fr)]">
			<div class="rounded-2xl border border-[rgba(15,27,43,0.08)] bg-[#f7f7f4] p-4 shadow-[0_10px_0_rgba(47,60,86,0.08)]">
				<div
					class="mb-3 inline-flex rounded-lg bg-[#2f3c56] px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.16em] text-[#f7f7f4]"
				>
					Desglose - mes / año
				</div>
				<div class="mb-4">
					<h3 class="mb-2 text-[11px] font-bold uppercase tracking-[0.12em] text-[#1d8f5a]">
						Ingresos
					</h3>
					<table class="w-full table-fixed border-collapse text-sm" id="tableIncome">
						<thead>
							<tr>
								<th
									class="w-[50%] border-b border-[#e1e3e6] px-2 py-2 text-left text-[10px] uppercase tracking-[0.1em] text-[#2f3c56]"
								>
									Concepto
								</th>
								<th
									class="w-[28%] border-b border-[#e1e3e6] px-2 py-2 text-right text-[10px] uppercase tracking-[0.1em] text-[#2f3c56]"
								>
									Importe
								</th>
								<th
									class="w-[22%] border-b border-[#e1e3e6] px-2 py-2 text-right text-[10px] uppercase tracking-[0.1em] text-[#2f3c56]"
								>
									Accion
								</th>
							</tr>
						</thead>
						<tbody></tbody>
					</table>
				</div>

				<div class="mb-4">
					<h3 class="mb-2 text-[11px] font-bold uppercase tracking-[0.12em] text-[#cc2e8c]">
						Gastos
					</h3>
					<table class="w-full table-fixed border-collapse text-sm" id="tableExpense">
						<thead>
							<tr>
								<th
									class="w-[50%] border-b border-[#e1e3e6] px-2 py-2 text-left text-[10px] uppercase tracking-[0.1em] text-[#2f3c56]"
								>
									Concepto
								</th>
								<th
									class="w-[28%] border-b border-[#e1e3e6] px-2 py-2 text-right text-[10px] uppercase tracking-[0.1em] text-[#2f3c56]"
								>
									Importe
								</th>
								<th
									class="w-[22%] border-b border-[#e1e3e6] px-2 py-2 text-right text-[10px] uppercase tracking-[0.1em] text-[#2f3c56]"
								>
									Accion
								</th>
							</tr>
						</thead>
						<tbody></tbody>
					</table>
				</div>

				<div>
					<h3 class="mb-2 text-[11px] font-bold uppercase tracking-[0.12em] text-[#2a6fd2]">
						Ahorros
					</h3>
					<table class="w-full table-fixed border-collapse text-sm" id="tableSavings">
						<thead>
							<tr>
								<th
									class="w-[50%] border-b border-[#e1e3e6] px-2 py-2 text-left text-[10px] uppercase tracking-[0.1em] text-[#2f3c56]"
								>
									Concepto
								</th>
								<th
									class="w-[28%] border-b border-[#e1e3e6] px-2 py-2 text-right text-[10px] uppercase tracking-[0.1em] text-[#2f3c56]"
								>
									Importe
								</th>
								<th
									class="w-[22%] border-b border-[#e1e3e6] px-2 py-2 text-right text-[10px] uppercase tracking-[0.1em] text-[#2f3c56]"
								>
									Accion
								</th>
							</tr>
						</thead>
						<tbody></tbody>
					</table>
				</div>
			</div>

			<div class="rounded-2xl border border-[rgba(15,27,43,0.08)] bg-[#f7f7f4] p-4 shadow-[0_10px_0_rgba(47,60,86,0.08)]">
				<div
					class="mb-3 inline-flex rounded-lg bg-[#2f3c56] px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.16em] text-[#f7f7f4]"
					id="summaryTitle"
				>
					Resumen - mes
				</div>
				<div class="grid gap-3">
					<div class="rounded-xl border border-[rgba(15,27,43,0.08)] bg-white p-4">
						<div class="mb-3 flex items-center justify-between text-sm font-semibold">
							<h4 class="text-xs font-bold uppercase tracking-[0.1em] text-[#2f3c56]">
								Ingresos
							</h4>
							<span id="totalIncome">$0</span>
						</div>
						<div class="ring green" id="ringIncome"></div>
						<ul class="grid gap-2 text-xs text-[#2f3c56]" id="listIncome"></ul>
					</div>

					<div class="rounded-xl border border-[rgba(15,27,43,0.08)] bg-white p-4">
						<div class="mb-3 flex items-center justify-between text-sm font-semibold">
							<h4 class="text-xs font-bold uppercase tracking-[0.1em] text-[#2f3c56]">
								Gastos
							</h4>
							<span id="totalExpense">$0</span>
						</div>
						<div class="ring pink" id="ringExpense"></div>
						<ul class="grid gap-2 text-xs text-[#2f3c56]" id="listExpense"></ul>
					</div>

					<div class="rounded-xl border border-[rgba(15,27,43,0.08)] bg-white p-4">
						<div class="mb-3 flex items-center justify-between text-sm font-semibold">
							<h4 class="text-xs font-bold uppercase tracking-[0.1em] text-[#2f3c56]">
								Ahorros
							</h4>
							<span id="totalSavings">$0</span>
						</div>
						<div class="ring blue" id="ringSavings"></div>
						<ul class="grid gap-2 text-xs text-[#2f3c56]" id="listSavings"></ul>
					</div>
				</div>
			</div>
		</section>
	</div>

	<script define:vars={{ apiBase }}>
		const monthInput = document.getElementById('monthInput');
		const rangeMonthly = document.getElementById('rangeMonthly');
		const rangeAnnual = document.getElementById('rangeAnnual');
		const periodProgress = document.getElementById('periodProgress');
		const periodLabel = document.getElementById('periodLabel');
		const savingsRate = document.getElementById('savingsRate');
		const remainingBalance = document.getElementById('remainingBalance');
		const summaryTitle = document.getElementById('summaryTitle');
		const entryMessage = document.getElementById('entryMessage');
		const labelInput = document.getElementById('labelInput');
		const amountInput = document.getElementById('amountInput');
		const normalizeBase = (value) => (value || '').replace(/\/+$/, '');
		const getAuthToken = () => localStorage.getItem('authToken');
		const buildAuthHeaders = () => {
			const token = getAuthToken();
			return token ? { Authorization: `Bearer ${token}` } : {};
		};
		const parseJsonSafe = async (response) => {
			const text = await response.text();
			if (!text) return {};
			try {
				return JSON.parse(text);
			} catch {
				return {};
			}
		};

		const formatCurrency = (value) =>
			new Intl.NumberFormat('es-CO', {
				style: 'currency',
				currency: 'COP',
				maximumFractionDigits: 0,
			}).format(value || 0);

		const getMonthValue = (date) =>
			`${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`;

		const setMonthBounds = () => {
			const now = new Date();
			const max = getMonthValue(now);
			monthInput.max = max;
			monthInput.value = monthInput.value || max;
		};

		const getPeriodProgress = (monthValue, range) => {
			const [year, month] = monthValue.split('-').map(Number);
			const now = new Date();
			if (range === 'annual') {
				if (year < now.getFullYear()) return 100;
				if (year > now.getFullYear()) return 0;
				return Math.min(100, Math.round(((now.getMonth() + 1) / 12) * 100));
			}
			if (year < now.getFullYear() || (year === now.getFullYear() && month - 1 < now.getMonth())) {
				return 100;
			}
			if (year > now.getFullYear() || (year === now.getFullYear() && month - 1 > now.getMonth())) {
				return 0;
			}
			const daysInMonth = new Date(year, month, 0).getDate();
			return Math.min(100, Math.round((now.getDate() / daysInMonth) * 100));
		};

		const renderTable = (tableId, items) => {
			const tbody = document.querySelector(`${tableId} tbody`);
			tbody.innerHTML = '';
			if (!items.length) {
				const row = document.createElement('tr');
				row.innerHTML = `<td class="muted text-center" colspan="3">Sin registros</td>`;
				tbody.appendChild(row);
				return;
			}
			items.forEach((item) => {
				const row = document.createElement('tr');
				row.innerHTML = `
					<td class="px-2 py-2 text-left">${item.label}</td>
					<td class="px-2 py-2 text-right tabular-nums">${formatCurrency(item.amount)}</td>
					<td class="px-2 py-2 text-right">
						<button
							class="rounded-md border border-[#e1e3e6] px-2 py-1 text-[11px] font-semibold text-[#2f3c56]"
							data-delete-id="${item.id}"
							data-delete-category="${item.category}"
							type="button"
						>
							Eliminar
						</button>
					</td>
				`;
				tbody.appendChild(row);
			});
		};

		const renderList = (listId, items) => {
			const list = document.getElementById(listId);
			list.innerHTML = '';
			if (!items.length) {
				list.innerHTML = `<li class="muted">Sin registros</li>`;
				return;
			}
			items.forEach((item) => {
				const li = document.createElement('li');
				li.innerHTML = `<span>${item.label}</span><span>${formatCurrency(item.amount)}</span>`;
				list.appendChild(li);
			});
		};

		const setRing = (id, total, grandTotal) => {
			const ring = document.getElementById(id);
			const percent = grandTotal ? Math.round((total / grandTotal) * 100) : 0;
			ring.style.setProperty('--ring-fill', `${percent}%`);
		};

		let range = 'monthly';

		const loadData = async () => {
			entryMessage.textContent = '';
			if (!apiBase) {
				entryMessage.textContent = 'Falta configurar la URL del backend.';
				return;
			}
			const authHeaders = buildAuthHeaders();
			if (!authHeaders.Authorization) {
				entryMessage.textContent = 'Debes iniciar sesion para ver el dashboard.';
				return;
			}
			const baseUrl = normalizeBase(apiBase);
			const monthValue = monthInput.value;
			const summaryResponse = await fetch(
				`${baseUrl}/entries/summary?month=${monthValue}&range=${range}`,
				{ headers: { Accept: 'application/json', ...authHeaders } }
			);
			const summary = await parseJsonSafe(summaryResponse);
			if (!summaryResponse.ok) {
				entryMessage.textContent = summary.message || 'No se pudo cargar el resumen.';
				return;
			}
			const entriesResponse = await fetch(`${baseUrl}/entries?month=${monthValue}`, {
				headers: { Accept: 'application/json', ...authHeaders },
			});
			const entries = await parseJsonSafe(entriesResponse);
			if (!entriesResponse.ok) {
				entryMessage.textContent = entries.message || 'No se pudieron cargar los movimientos.';
				return;
			}

			summaryTitle.textContent = `Resumen - ${range === 'monthly' ? 'mes' : 'año'}`;
			const progress = getPeriodProgress(monthValue, range === 'monthly' ? 'monthly' : 'annual');
			periodProgress.style.width = `${progress}%`;
			periodLabel.textContent = `${progress}%`;
			savingsRate.textContent = `Ahorro ${summary.rate}% de tus ingresos`;
			const remaining = summary.totals.income - summary.totals.expense - summary.totals.savings;
			remainingBalance.textContent = formatCurrency(remaining);

			document.getElementById('totalIncome').textContent = formatCurrency(summary.totals.income);
			document.getElementById('totalExpense').textContent = formatCurrency(summary.totals.expense);
			document.getElementById('totalSavings').textContent = formatCurrency(summary.totals.savings);

			setRing('ringIncome', summary.totals.income, summary.grandTotal);
			setRing('ringExpense', summary.totals.expense, summary.grandTotal);
			setRing('ringSavings', summary.totals.savings, summary.grandTotal);

			renderList('listIncome', summary.breakdown.income);
			renderList('listExpense', summary.breakdown.expense);
			renderList('listSavings', summary.breakdown.savings);

			const incomeRows = entries.entries.filter((entry) => entry.category === 'income');
			const expenseRows = entries.entries.filter((entry) => entry.category === 'expense');
			const savingsRows = entries.entries.filter((entry) => entry.category === 'savings');

			renderTable('#tableIncome', incomeRows);
			renderTable('#tableExpense', expenseRows);
			renderTable('#tableSavings', savingsRows);
		};

		const handleRange = (nextRange) => {
			range = nextRange;
			rangeMonthly.classList.toggle('active', range === 'monthly');
			rangeAnnual.classList.toggle('active', range === 'annual');
			loadData();
		};

		document.querySelectorAll('button[data-category]').forEach((button) => {
			button.addEventListener('click', async () => {
				entryMessage.textContent = '';
				if (!apiBase) {
					entryMessage.textContent = 'Falta configurar la URL del backend.';
					return;
				}
				const authHeaders = buildAuthHeaders();
				if (!authHeaders.Authorization) {
					entryMessage.textContent = 'Debes iniciar sesion para registrar movimientos.';
					return;
				}
				const label = labelInput.value.trim();
				const amount = Number(amountInput.value);
				if (!label || Number.isNaN(amount) || amount <= 0) {
					entryMessage.textContent = 'Completa concepto y monto valido.';
					return;
				}
				const baseUrl = normalizeBase(apiBase);
				const payload = {
					month: monthInput.value,
					category: button.dataset.category,
					label,
					amount,
				};
				const response = await fetch(`${baseUrl}/entries`, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json', ...authHeaders },
					body: JSON.stringify(payload),
				});
				if (!response.ok) {
					const error = await parseJsonSafe(response);
					entryMessage.textContent = error.message || 'No se pudo guardar.';
					return;
				}
				labelInput.value = '';
				amountInput.value = '';
				entryMessage.textContent = 'Movimiento guardado.';
				loadData();
			});
		});

		document.addEventListener('click', async (event) => {
			const target = event.target;
			if (!(target instanceof HTMLButtonElement)) return;
			const entryId = target.dataset.deleteId;
			if (!entryId) return;
			if (!apiBase) {
				entryMessage.textContent = 'Falta configurar la URL del backend.';
				return;
			}
			const authHeaders = buildAuthHeaders();
			if (!authHeaders.Authorization) {
				entryMessage.textContent = 'Debes iniciar sesion para eliminar movimientos.';
				return;
			}
			const confirmed = window.confirm('Deseas eliminar este movimiento?');
			if (!confirmed) return;
			const baseUrl = normalizeBase(apiBase);
			const response = await fetch(`${baseUrl}/entries`, {
				method: 'DELETE',
				headers: { 'Content-Type': 'application/json', ...authHeaders },
				body: JSON.stringify({ id: entryId }),
			});
			if (!response.ok) {
				const error = await parseJsonSafe(response);
				entryMessage.textContent = error.message || 'No se pudo eliminar.';
				return;
			}
			entryMessage.textContent = 'Movimiento eliminado.';
			loadData();
		});

		rangeMonthly.addEventListener('click', () => handleRange('monthly'));
		rangeAnnual.addEventListener('click', () => handleRange('annual'));
		monthInput.addEventListener('change', loadData);

		setMonthBounds();
		loadData();
	</script>
</Layout>

<style>
	.pill.active {
		background-color: #2f3c56;
		border-color: #2f3c56;
		color: #f7f7f4;
	}

	.muted {
		color: #8b9096;
	}

	.ring {
		--ring-fill: 0%;
		--ring-track: #e1e3e6;
		--ring-color: #1d8f5a;
		height: 86px;
		width: 86px;
		border-radius: 999px;
		display: grid;
		place-items: center;
		background: conic-gradient(var(--ring-color) var(--ring-fill), var(--ring-track) 0);
		margin: 0 auto;
	}

	.ring::after {
		content: '';
		height: 58px;
		width: 58px;
		border-radius: 999px;
		background: #ffffff;
		box-shadow: inset 0 0 0 1px rgba(15, 27, 43, 0.08);
	}

	.ring.green {
		--ring-color: #1d8f5a;
	}

	.ring.pink {
		--ring-color: #cc2e8c;
	}

	.ring.blue {
		--ring-color: #2a6fd2;
	}
</style>

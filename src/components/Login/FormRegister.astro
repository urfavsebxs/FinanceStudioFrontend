---
// Registration form component
const apiBase = import.meta.env.DEV
	? import.meta.env.PUBLIC_BACKEND_URL_DEV
	: import.meta.env.PUBLIC_BACKEND_URL_PROD;
---

<section class="w-full">
	<form
		id="registerForm"
		class="flex w-full flex-col gap-4 bg-white/95 p-6 ring-1 ring-slate-200 sm:gap-5 sm:p-8"
	>
		<div class="flex flex-col gap-1">
			<h2 class="text-xl font-semibold text-[#2F3E58] sm:text-2xl">Crea tu cuenta</h2>
			<p class="text-sm text-slate-700 sm:text-base">
				Solo pedimos lo esencial para abrir tu cuenta.
			</p>
		</div>

		<div class="flex flex-col gap-1">
			<label class="text-sm font-semibold text-slate-700" for="fullName">
				Nombre completo
			</label>
			<input
				id="fullName"
				name="fullName"
				type="text"
				autocomplete="name"
				aria-describedby="fullNameHelp"
				required
				class="h-11 rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-800 placeholder:text-slate-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#2F3E58]/70"
				placeholder="Tu nombre y apellido"
			/>
			<p id="fullNameHelp" class="text-xs text-slate-500">
				Usaremos este nombre para personalizar tu panel.
			</p>
		</div>

		<div class="flex flex-col gap-1">
			<label class="text-sm font-semibold text-slate-700" for="email">
				Correo electrónico
			</label>
			<input
				id="email"
				name="email"
				type="email"
				autocomplete="email"
				inputmode="email"
				aria-describedby="emailHelp"
				required
				class="h-11 rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-800 placeholder:text-slate-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#2F3E58]/70"
				placeholder="correo@ejemplo.com"
			/>
			<p id="emailHelp" class="text-xs text-slate-500">
				Enviaremos un mensaje de verificación.
			</p>
		</div>

		<div class="flex flex-col gap-1">
			<label class="text-sm font-semibold text-slate-700" for="password">
				Contraseña
			</label>
			<input
				id="password"
				name="password"
				type="password"
				autocomplete="new-password"
				aria-describedby="passwordHelp"
				required
				minlength="8"
				class="h-11 rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-800 placeholder:text-slate-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#2F3E58]/70"
				placeholder="Minimo 8 caracteres"
			/>
			<p id="passwordHelp" class="text-xs text-slate-500">
				Minimo 8 caracteres, incluye letras y numeros.
			</p>
		</div>

		<label class="flex items-start gap-2 text-xs text-slate-700 sm:text-sm">
			<input
				type="checkbox"
				name="terms"
				required
				class="mt-0.5 h-4 w-4 rounded border-slate-300 text-[#2F3E58] focus-visible:ring-2 focus-visible:ring-[#2F3E58]/70"
			/>
			<span>
				Acepto los términos y la política de privacidad.
			</span>
		</label>

		<div class="flex flex-col gap-1">
			<button
				type="submit"
				id="registerSubmit"
				class="inline-flex h-11 items-center justify-center rounded-full bg-[#2F3E58] px-5 text-sm font-semibold text-white transition hover:bg-[#27324A] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#2F3E58]/70"
			>
				Crear cuenta
			</button>
			<div
				id="registerStatus"
				class="hidden rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-xs text-slate-700"
				role="status"
				aria-live="polite"
			></div>
			<p class="text-xs text-slate-500">
				Al crear la cuenta, habilitas el panel financiero personal.
			</p>
		</div>
	</form>
</section>

<script define:vars={{ apiBase }}>
	const form = document.querySelector('#registerForm');
	const status = document.querySelector('#registerStatus');
	const submitButton = document.querySelector('#registerSubmit');
	const normalizeBase = (value) => (value || '').replace(/\/+$/, '');

	const setStatus = (message, type = 'info') => {
		if (!status) return;
		status.textContent = message;
		status.classList.remove('hidden', 'border-emerald-200', 'bg-emerald-50', 'text-emerald-700', 'border-rose-200', 'bg-rose-50', 'text-rose-700');
		if (type === 'success') {
			status.classList.add('border-emerald-200', 'bg-emerald-50', 'text-emerald-700');
			return;
		}
		if (type === 'error') {
			status.classList.add('border-rose-200', 'bg-rose-50', 'text-rose-700');
			return;
		}
		status.classList.add('border-slate-200', 'bg-slate-50', 'text-slate-700');
	};

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (!apiBase) {
			setStatus('Falta configurar la URL del backend.', 'error');
			return;
		}

		const formData = new FormData(form);
		const payload = {
			fullName: String(formData.get('fullName') || '').trim(),
			email: String(formData.get('email') || '').trim(),
			password: String(formData.get('password') || ''),
		};

		if (!payload.fullName || !payload.email || !payload.password) {
			setStatus('Completa todos los campos requeridos.', 'error');
			return;
		}

		const baseUrl = normalizeBase(apiBase);
		setStatus('Creando tu cuenta...');
		submitButton?.setAttribute('disabled', 'true');
		submitButton?.classList.add('opacity-70', 'cursor-not-allowed');

		try {
			const response = await fetch(`${baseUrl}/auth/register`, {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json',
					'Accept': 'application/json',
				},
				body: JSON.stringify(payload),
			});

			const data = await response.json().catch(() => ({}));
			if (!response.ok) {
				const message = data?.message || 'No se pudo crear la cuenta.';
				setStatus(message, 'error');
				return;
			}

			setStatus('Cuenta creada. Ya puedes iniciar sesion.', 'success');
			setTimeout(() => {
				window.location.href = '/login';
			}, 800);
		} catch (error) {
			console.error(error);
			setStatus('Ocurrio un error de conexion.', 'error');
		} finally {
			submitButton?.removeAttribute('disabled');
			submitButton?.classList.remove('opacity-70', 'cursor-not-allowed');
		}
	});
</script>
